<% content_for :title, "Posts" %>

<section aria-labelledby="posts-heading">
  <h1 id="posts-heading">Posts</h1>

  <% if @posts.empty? %>
    <p>Nenhum post publicado ainda.</p>
  <% else %>
    <ol class="posts-list" role="list" aria-label="Lista de posts publicados">
      <% @posts.each do |post| %>
        <li>
          <article class="post-card" aria-labelledby="post-title-<%= post.id %>">
            <h2 id="post-title-<%= post.id %>" class="post-card__title">
              <%= link_to post.title, post_path(post) %>
            </h2>
            <% if post.published_at.present? %>
              <p class="post-card__meta">
                <time datetime="<%= post.published_at.iso8601 %>">
                  <%= l(post.published_at, format: :long) %>
                </time>
              </p>
            <% end %>
            <p class="post-card__excerpt">
              <%= truncate(post.content, length: 200, separator: " ") %>
            </p>
            <p>
              <%= link_to "Ler post: #{post.title}", post_path(post), class: "read-more", aria: { label: "Ler post: #{post.title}" } %>
            </p>
          </article>
        </li>
      <% end %>
    </ol>
  <% end %>
</section>
