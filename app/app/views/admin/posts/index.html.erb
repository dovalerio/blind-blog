<% content_for :title, "Gerenciar Posts" %>

<section aria-labelledby="admin-posts-heading">
  <div class="d-flex align-items-center justify-content-between mb-4 gap-3 flex-wrap">
    <h1 id="admin-posts-heading" class="mb-0">Gerenciar Posts</h1>
    <%= link_to "Novo post", new_admin_post_path, class: "btn btn-primary" %>
  </div>

  <% if @posts.empty? %>
    <p>Nenhum post criado ainda.</p>
  <% else %>
    <div class="table-responsive">
      <table class="table table-hover table-bordered align-middle" aria-label="Lista de posts">
        <thead class="table-light">
          <tr>
            <th scope="col">Título</th>
            <th scope="col">Status</th>
            <th scope="col">Data</th>
            <th scope="col"><span class="visually-hidden">Ações</span></th>
          </tr>
        </thead>
        <tbody>
          <% @posts.each do |post| %>
            <tr>
              <td><%= post.title %></td>
              <td>
                <% if post.published? %>
                  <span class="badge text-bg-success">Publicado</span>
                <% else %>
                  <span class="badge text-bg-secondary">Rascunho</span>
                <% end %>
              </td>
              <td>
                <time datetime="<%= post.created_at.iso8601 %>">
                  <%= l(post.created_at, format: :short) %>
                </time>
              </td>
              <td>
                <div class="d-flex gap-2 align-items-center flex-wrap">
                  <%= link_to "Editar", edit_admin_post_path(post), class: "btn btn-sm btn-outline-primary", aria: { label: "Editar: #{post.title}" } %>
                  <%= button_to "Remover", admin_post_path(post),
                        method: :delete,
                        class: "btn btn-sm btn-outline-danger",
                        form: { "aria-label": "Remover post: #{post.title}" },
                        data: { turbo_confirm: "Confirma remoção do post \"#{post.title}\"?" } %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
